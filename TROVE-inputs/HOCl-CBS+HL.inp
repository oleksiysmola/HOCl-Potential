mem 1300 gb

KinOrder   2  (Max order in the kinetic energy expansion)
PotOrder   8   (Max order in the potential energy expansion)

Natoms 3      (Number of atoms)
Nmodes 3      (Number of modes = 3*Natoms-6)

(ACTIVE SPACE CUTOFFS:)
PRIMITIVES
  Npolyads       32           (how many polyads we calculate)
  enercut       100000.      (energy cut in the primitive matrix for the diagonalization)
END



CONTRACTION
  Npolyads        32      (how many polyads in the contracted represent.)
  enercut       48000.    (energy cut in the primitive matrix for the diagonalization)
  degeneracy    1e-2       (threashold to define degeneracy)
  sample_points   40
  sample_attempts 500
  symm_toler      1e-3
  coeff_thresh    1e-18   (  rotsym        euler )
END

verbose 4


dstep 0.001   (finite difference element for each mode )

COORDS       local   (type of the internal coordinates: linear or local)
TRANSFORM    R2-Z-R1-RHO
MOLTYPE      XY2    (Identifying type of the Molecule (e.g. XY3))
MOLECULE     HOCl   (Identifying the Molecule, e.g. PH3, BiH3 - optional)
REFER-CONF   NON-RIGID  (Reference configuarion: RIGID or NON-RIGID)


SINGULAR-AXIS 3


SYMGROUP Csn 16


ZMAT
    O   0  0  0  0   15.99059462
    H   1  0  0  0   1.00782503224
   Cl   1  2  0  0   34.965012622636
end


DIAGONALIZER
 SYEV
 enermax 30000
end


CHECK_POINT
ascii
 kinetic     save
 potential   save
 external    none
 basis_set   save
 contract    save
 matelem     save    split
 extmatelem  none    split 1 174
 eigenfunc   save
END

     (type     chi_kin   chi_pot)

BASIS
 0,'JKtau', Jrot 0 krot 16
  1,'numerov','rational', 'morse',  range 0,18,  resc 1.5, points  2000, borders -0.34,2.5
  2,'numerov','rational', 'morse',  range 0,28,  resc 1.0, points  2000, borders -0.40,1.8
  3,'laguerre-k','linear','linear', range 0,28,  resc 1.0, points  4000, borders  0.,140.0 deg
END


sparse


KINETIC
  kinetic_type  KINETIC_XYZ_EKE_BOND-R2
END


EQUILIBRIUM
RE12          9     0.964019248686
RE32          9     1.691876826655
alphae        9     102.680065681085    deg
end



SPECPARAM
a1             0      1.661752293125
a2             0      2.682425041374
fm             0      5.0
END




