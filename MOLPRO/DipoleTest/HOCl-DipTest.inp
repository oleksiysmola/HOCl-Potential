***,HOCl DMS surface
memory,500,m;

gthresh,energy=1.d-12,zero=1.d-14,thrint=1.d-14,oneint=1.d-14,twoint=1.d-14,prefac=1.d-20

point = 1
roh = 0.96446195
rocl = 1.68888476
alpha = 103.00000000


ORIENT, NOORIENT
geometry={angstrom
o, 0.d0,0.d0,0.d0
h, roh*sin(180.d0 - alpha),0.d0,roh*cos(180.d0 - alpha)
cl,0.d0,0.d0,-rocl
}

field=[-0.001d0, 0.001d0]


basis=aug-cc-pVDZ

dip,field(1)
hf
{ccsd(t);
core,5,1}
ex6d1=energy
dip,field(2)
hf
{ccsd(t);
core,5,1}
ex6d2=energy
dipau=(ex6d2-ex6d1)/(field(2)-field(1))
dipole(1)=dipau*TODEBYE

dip,,,field(1)
hf
{ccsd(t);
core,5,1}
ex6d1=energy
dip,,,field(2)
hf
{ccsd(t);
core,5,1}
ex6d2=energy
dipau=(ex6d2-ex6d1)/(field(2)-field(1))
dipole(2)=dipau*TODEBYE

xxx = "mmm"
point = 1.00000000
text ### HOCl
table,xxx(3),roh,rocl,alpha,dipole(1),dipole(2),point
DIGITS, 0, 8, 8, 8, 12, 12, 4